# ---------- Auth (Auth.js / NextAuth v5) ----------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google  (+ your production URL)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Optional: only allow these email domains to sign in (comma separated), e.g. "acme.com,acme.co.uk"
ALLOWED_EMAIL_DOMAINS=

# ---------- Database (Postgres: Supabase / Neon / local) ----------
DATABASE_URL=postgres://user:password@host:5432/postgres
# Set to "false" for a local Postgres without SSL (auto-detected for localhost)
DATABASE_SSL=

# ---------- Vision model ----------
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Tried in order. When one hits its free quota the next one is used automatically.
# gemini-3.8-flash = most accurate (small free quota); gemini-3.5-flash-lite = large free quota.
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.8-flash
# Optional last-resort fallback. Free key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
# Optional: ISO country used to format phone numbers printed without a country code (e.g. IN, US, GB)
DEFAULT_PHONE_COUNTRY=

# ---------- Image storage (Supabase) ----------
# If set, card images go to Supabase Storage (create a PRIVATE bucket first).
# If empty, images are saved to ./uploads on local disk (fine for local dev, NOT for Vercel).
# Project Settings -> Data API: Project URL
SUPABASE_URL=
# Project Settings -> API Keys -> Secret keys (starts with sb_secret_). Server-only, never share it.
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET=cards
